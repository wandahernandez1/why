---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/ui/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import Servicios from '../components/landing/Servicios.astro';
import Demos from '../components/landing/Demos.astro';
import Proceso from '../components/landing/Proceso.astro';
import Faq from '../components/landing/Faq.astro';
import Cierre from '../components/landing/Cierre.astro';
import Footer from '../components/landing/Footer.astro';
import BarraMovil from '../components/ui/BarraMovil.astro';
import site from '../data/site.json';
import { aNumero, esPlaceholder } from '../scripts/formato';
import { limpiarNumero } from '../scripts/whatsapp';

const mensaje = `Hola ${site.nombrePersona}! Vi la web de ${site.marca} y quiero consultar por una página para mi negocio.`;
const descripcion = `Webs con tu marca para negocios locales: pedidos y turnos directo a tu WhatsApp. Sin comisiones por venta, online en 7 a 15 días. ${site.ciudadZona}.`;

// Datos estructurados (schema.org). Los campos con placeholder se omiten.
const real = (v: string) => (v && !esPlaceholder(v) ? v : undefined);
const telefono = limpiarNumero(site.whatsapp);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: real(site.marca),
  description: descripcion,
  url: Astro.site?.href,
  image: new URL('/img/og.png', Astro.site).href,
  areaServed: real(site.ciudadZona),
  email: real(site.email),
  telephone: telefono ? `+${telefono}` : undefined,
  sameAs: real(site.instagram) ? [site.instagram] : undefined,
  knowsLanguage: 'es-AR',
  makesOffer: site.planes.map((p) => {
    const precio = aNumero(p.precioDesde);
    return {
      '@type': 'Offer',
      name: p.nombre,
      description: `Para: ${p.para}. ${p.incluye.join('. ')}.`,
      ...(precio !== null && {
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: precio,
          priceCurrency: site.moneda,
        },
      }),
    };
  }),
};
---

<BaseLayout
  title={`${site.marca} `}
  description={descripcion}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <a href="#contenido" class="saltar">Saltar al contenido</a>
  <Nav mensaje={mensaje} variante="hero" />
  <main id="contenido">
    <Hero mensaje={mensaje} />
    <Servicios />
    <Demos />
    <Proceso />
    <Faq />
    <Cierre mensaje={mensaje} />
  </main>
  <Footer conBarraMovil />
  <BarraMovil mensaje={mensaje} />
</BaseLayout>

<style>
  main {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 42rem 28rem at 100% 18%, rgba(116, 48, 71, 0.08), transparent 72%),
      linear-gradient(180deg, #0b0d0c 0%, #101310 44%, #0b0d0c 100%);
    color: var(--texto-2);
  }
  main :global(.seccion),
  main :global(.contenedor) {
    position: relative;
    z-index: 1;
  }
  .saltar {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 12px 16px;
    border-radius: var(--r-boton);
    background: var(--accion);
    color: #10150e;
    font-weight: 500;
  }
  .saltar:focus {
    top: 16px;
  }
</style>
