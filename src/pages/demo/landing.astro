---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Demo de landing pages · why"
  description="Personalizá una landing page comercial y probá su vista responsive."
  noindex
  themeColor="#0b0d0c"
  estiloBody="background:#0b0d0c;color:#f4f6f3"
>
  <main class="constructor" data-landing-demo>
    <header class="barra-demo">
      <a class="marca-estudio" href="/">why</a>
      <span class="modo"><i></i> MODO DEMOSTRACIÓN</span>
      <a class="volver" href="/#demos">Volver a las soluciones</a>
    </header>

    <section class="intro">
      <p class="eyebrow">LANDING PAGE · PERSONALIZABLE</p>
      <h1>Una web que ya se siente <em>tuya.</em></h1>
      <p>Probá una identidad, editá el contenido y cambiá entre escritorio y celular. Tus cambios quedan guardados en este navegador.</p>
    </section>

    <div class="workspace">
      <aside class="editor" aria-labelledby="editor-titulo">
        <div class="editor-head">
          <div>
            <p class="eyebrow">TU NEGOCIO</p>
            <h2 id="editor-titulo">Personalizá la demo</h2>
          </div>
          <button type="button" class="restaurar" data-restaurar>Restaurar</button>
        </div>

        <form data-configuracion>
          <fieldset>
            <legend>Identidad y contenido</legend>
            <label>Nombre del negocio<input name="nombre" maxlength="48" required /></label>
            <label>Monograma o iniciales<input name="monograma" maxlength="4" required /></label>
            <label>Título principal<input name="titulo" maxlength="100" required /></label>
            <label>Descripción<textarea name="descripcion" rows="3" maxlength="220" required></textarea></label>
            <label>Texto del botón<input name="llamadaAccion" maxlength="40" required /></label>
          </fieldset>

          <fieldset>
            <legend>Estilo visual</legend>
            <div class="colores">
              <label>Fondo <input name="colorFondo" type="color" /></label>
              <label>Acento <input name="colorAcento" type="color" /></label>
            </div>
            <label>Tipografía
              <select name="tipografia">
                <option value="serif">Editorial</option>
                <option value="sans">Contemporánea</option>
              </select>
            </label>
            <label>Imagen principal
              <select name="imagen">
                <option value="/img/hero-glass-orb.webp">Forma de vidrio</option>
                <option value="/img/hero-liquid-metal.webp">Metal líquido</option>
                <option value="/brand/emoji/color.webp">Color y textura</option>
              </select>
            </label>
          </fieldset>

          <fieldset>
            <legend>Servicios y contacto</legend>
            <label>Servicios <span class="ayuda">Uno por línea. Separá el precio con |</span>
              <textarea name="servicios" rows="4" maxlength="450" required></textarea>
            </label>
            <label>WhatsApp<input name="whatsapp" inputmode="tel" maxlength="18" /></label>
            <label>Email de contacto<input name="email" type="email" maxlength="100" /></label>
          </fieldset>

          <fieldset class="secciones">
            <legend>Secciones visibles</legend>
            <label><input type="checkbox" name="seccion-servicios" /> Servicios</label>
            <label><input type="checkbox" name="seccion-portfolio" /> Portfolio</label>
            <label><input type="checkbox" name="seccion-opiniones" /> Testimonios</label>
            <label><input type="checkbox" name="seccion-contacto" /> Contacto</label>
          </fieldset>
          <p class="guardado" data-estado-guardado role="status" aria-live="polite"></p>
        </form>

        <p class="nota-editor">Los formularios son simulados. No se envían datos ni se contacta a servicios externos.</p>
      </aside>

      <section class="preview" aria-label="Vista previa de la landing page">
        <div class="preview-toolbar">
          <div class="selector-vista" role="group" aria-label="Tamaño de vista previa">
            <button type="button" data-vista="desktop" aria-pressed="true">Escritorio</button>
            <button type="button" data-vista="mobile" aria-pressed="false">Celular</button>
          </div>
          <span class="preview-label">VISTA PREVIA RESPONSIVE</span>
        </div>

        <div class="marco-preview" data-marco data-vista="desktop">
          <div class="sitio" data-sitio>
            <header class="sitio-nav">
              <a href="#inicio" class="sitio-marca"><span data-monograma></span><span data-nombre></span></a>
              <nav aria-label="Secciones de la página">
                <a href="#servicios">Servicios</a>
                <a href="#portfolio">Portfolio</a>
                <a href="#contacto">Contacto</a>
              </nav>
              <a class="nav-cta" href="#contacto" data-cta></a>
            </header>

            <section id="inicio" class="hero-preview">
              <div class="hero-texto">
                <p class="hero-kicker"><span></span> DISEÑO CON INTENCIÓN</p>
                <h2 data-titulo></h2>
                <p class="hero-descripcion" data-descripcion></p>
                <a href="#contacto" class="boton-preview" data-cta></a>
                <p class="hero-confianza">Ideas claras. Diseño cuidado. Resultados que se notan.</p>
              </div>
              <div class="hero-imagen"><img data-imagen alt="Imagen abstracta de la marca" /></div>
            </section>

            <section id="servicios" class="seccion-preview servicios-preview" data-seccion="servicios">
              <p class="seccion-kicker">LO QUE HACEMOS</p>
              <h2>Ideas y soluciones para crecer.</h2>
              <ul data-lista-servicios></ul>
            </section>

            <section id="portfolio" class="seccion-preview portfolio-preview" data-seccion="portfolio">
              <div>
                <p class="seccion-kicker">TRABAJO SELECCIONADO</p>
                <h2>Marcas con una historia propia.</h2>
              </div>
              <div class="portfolio-grid">
                <article><span>01 / IDENTIDAD</span><strong>Un universo visual coherente</strong></article>
                <article><span>02 / DIGITAL</span><strong>Experiencias simples y claras</strong></article>
                <article><span>03 / CONTENIDO</span><strong>Ideas que encuentran su forma</strong></article>
              </div>
            </section>

            <section class="seccion-preview opinion-preview" data-seccion="opiniones">
              <p class="seccion-kicker">PALABRAS QUE NOS IMPULSAN</p>
              <blockquote>“Entendieron la esencia de la marca y la llevaron a un lugar mucho más claro y profesional.”</blockquote>
              <p class="firma-opinion">— Clara M. · Emprendedora</p>
            </section>

            <section id="contacto" class="contacto-preview seccion-preview" data-seccion="contacto">
              <div>
                <p class="seccion-kicker">HAGAMOS ALGO BUENO</p>
                <h2>Contanos qué tenés en mente.</h2>
                <p class="contacto-email" data-email></p>
                <p class="contacto-email" data-telefono></p>
                <button type="button" class="boton-preview" data-whatsapp-demo>Probar WhatsApp</button>
              </div>
              <form data-form-contacto>
                <label>Tu nombre<input name="nombre" autocomplete="name" required minlength="2" /></label>
                <label>Tu email<input name="email" type="email" autocomplete="email" required /></label>
                <label>¿En qué podemos ayudarte?<textarea name="mensaje" rows="3" required minlength="8"></textarea></label>
                <button type="submit" class="boton-preview">Enviar consulta</button>
                <p data-contacto-estado role="status" aria-live="polite"></p>
              </form>
            </section>

            <footer class="sitio-footer">
              <a href="#inicio"><span data-monograma></span> <span data-nombre></span></a>
              <span>Una marca, muchas posibilidades.</span>
              <a href="#contacto">Hablemos ↗</a>
            </footer>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import '../../scripts/landing-demo';
</script>

<style>
  .constructor {
    --ink: #f4f6f3;
    --muted: #c1c9c1;
    --line: #343c36;
    min-height: 100vh;
    padding: 18px clamp(16px, 4vw, 56px) 64px;
    color: var(--ink);
    font-family: 'DM Sans', sans-serif;
  }
  .barra-demo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1440px;
    margin: auto;
  }
  .marca-estudio {
    font-weight: 700;
    letter-spacing: -0.05em;
  }
  .marca-estudio span {
    color: var(--muted);
    font-weight: 400;
  }
  .modo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: 500 10px 'Geist Mono', monospace;
    letter-spacing: 0.06em;
  }
  .modo i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--verde);
  }
  .volver {
    color: var(--ink);
    font-size: 13px;
    text-underline-offset: 4px;
  }
  .intro {
    max-width: 1440px;
    margin: 60px auto 34px;
  }
  .eyebrow,
  .seccion-kicker {
    color: var(--verde);
    font: 500 10px/1.5 'Geist Mono', monospace;
    letter-spacing: 0.1em;
  }
  .intro h1 {
    margin-top: 12px;
    font-size: clamp(36px, 6vw, 58px);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.05;
  }
  .intro h1 em {
    color: var(--verde);
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
  }
  .intro > p:last-child {
    max-width: 620px;
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
  .workspace {
    display: grid;
    grid-template-columns: minmax(270px, 320px) minmax(0, 1fr);
    gap: 20px;
    max-width: 1440px;
    margin: auto;
    align-items: start;
  }
  .editor {
    position: sticky;
    top: 16px;
    max-height: calc(100vh - 32px);
    overflow: auto;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--vino-900);
    scrollbar-width: thin;
  }
  .editor-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 20px;
  }
  .editor h2 {
    margin-top: 5px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .restaurar {
    color: var(--verde);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .editor fieldset {
    display: grid;
    gap: 12px;
    padding: 17px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .editor legend {
    padding-top: 15px;
    font-size: 13px;
    font-weight: 600;
  }
  .editor label {
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
  }
  .editor input:not([type='checkbox']):not([type='color']),
  .editor textarea,
  .editor select {
    width: 100%;
    min-height: 40px;
    padding: 9px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--vino-950);
    color: var(--ink);
    font: 400 13px 'DM Sans', sans-serif;
  }
  .editor textarea {
    resize: vertical;
  }
  .editor input:focus,
  .editor textarea:focus,
  .editor select:focus,
  .preview input:focus,
  .preview textarea:focus {
    outline: 2px solid var(--verde);
    outline-offset: 2px;
  }
  .colores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .editor input[type='color'] {
    width: 100%;
    height: 40px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--vino-950);
  }
  .ayuda {
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
  }
  .secciones label {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .secciones input {
    accent-color: var(--verde);
  }
  .guardado {
    min-height: 18px;
    color: var(--verde);
    font-size: 12px;
  }
  .nota-editor {
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
  }
  .preview {
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--vino-900);
  }
  .preview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 0 12px;
  }
  .selector-vista {
    display: flex;
    gap: 3px;
    padding: 3px;
    border-radius: 9px;
    background: var(--vino-950);
  }
  .selector-vista button {
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 11px;
    cursor: pointer;
  }
  .selector-vista button[aria-pressed='true'] {
    background: var(--vino-800);
    color: var(--ink);
    box-shadow: 0 1px 3px #201c1a1c;
  }
  .preview-label {
    color: var(--muted);
    font: 500 9px 'Geist Mono', monospace;
    letter-spacing: 0.08em;
  }
  .marco-preview {
    max-width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--vino-950);
    box-shadow: 0 12px 30px #4c3a2b17;
    transition: max-width 240ms ease;
  }
  .marco-preview[data-vista='mobile'] {
    max-width: 390px;
  }
  .sitio {
    --brand-bg: #0b0d0c;
    --brand-accent: #b5d77b;
    --brand-text: #f4f6f3;
    --brand-muted: #c1c9c1;
    --brand-accent-text: #10150e;
    --brand-label: #b5d77b;
    overflow: hidden;
    background: var(--brand-bg);
    color: var(--brand-text);
    font-family: 'DM Sans', sans-serif;
    transition: background-color 200ms ease;
  }
  .sitio[data-tipografia='serif'] h2 {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
  }
  .sitio h2 {
    color: inherit;
  }
  .sitio .seccion-kicker {
    color: var(--brand-label);
  }
  .sitio-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 68px;
    padding: 0 clamp(16px, 4vw, 48px);
    border-bottom: 1px solid currentColor;
  }
  .sitio-marca,
  .sitio-footer > a:first-child {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .sitio-marca span:first-child,
  .sitio-footer > a:first-child span:first-child {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    background: var(--brand-accent);
    color: var(--brand-accent-text);
    font-size: 12px;
  }
  .sitio-nav nav {
    display: flex;
    gap: 22px;
    color: var(--brand-muted);
    font-size: 11px;
  }
  .nav-cta {
    padding: 9px 13px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 11px;
  }
  .hero-preview {
    display: grid;
    grid-template-columns: 1fr 0.88fr;
    align-items: center;
    gap: 5%;
    padding: clamp(32px, 7vw, 82px) clamp(18px, 7vw, 78px);
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--brand-label);
    font: 500 9px 'Geist Mono', monospace;
    letter-spacing: 0.1em;
  }
  .hero-kicker span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-accent);
  }
  .hero-preview h2 {
    max-width: 560px;
    margin-top: 20px;
    font-size: clamp(34px, 5vw, 62px);
    letter-spacing: -0.06em;
    line-height: 1.02;
  }
  .hero-descripcion {
    max-width: 430px;
    margin-top: 18px;
    color: var(--brand-muted);
    font-size: 14px;
    line-height: 1.65;
  }
  .boton-preview {
    display: inline-flex;
    justify-content: center;
    margin-top: 22px;
    padding: 12px 17px;
    border: 0;
    border-radius: 999px;
    background: var(--brand-accent);
    color: var(--brand-accent-text);
    font: 500 12px 'DM Sans', sans-serif;
    cursor: pointer;
  }
  .hero-confianza {
    margin-top: 17px;
    color: var(--brand-muted);
    font-size: 10px;
  }
  .hero-imagen {
    overflow: hidden;
    aspect-ratio: 0.9;
    border-radius: 48% 48% 12px 12px;
    background: #252a26;
  }
  .hero-imagen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .seccion-preview {
    padding: clamp(38px, 6vw, 70px) clamp(18px, 7vw, 78px);
  }
  .seccion-preview h2 {
    max-width: 600px;
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.055em;
    line-height: 1.08;
  }
  .servicios-preview > ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 25px;
  }
  .servicios-preview li {
    min-height: 110px;
    padding: 16px;
    border: 1px solid currentColor;
    border-radius: 12px;
  }
  .servicios-preview li strong,
  .servicios-preview li span {
    display: block;
  }
  .servicios-preview li strong {
    font-size: 13px;
  }
  .servicios-preview li span {
    margin-top: 14px;
    color: var(--brand-label);
    font-size: 11px;
  }
  .portfolio-preview,
  .contacto-preview {
    background: #202722;
    color: #fffdfa;
  }
  .portfolio-preview .seccion-kicker,
  .contacto-preview .seccion-kicker {
    color: var(--verde);
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 25px;
  }
  .portfolio-grid article {
    display: flex;
    min-height: 145px;
    flex-direction: column;
    justify-content: space-between;
    padding: 15px;
    border: 1px solid #ffffff24;
    border-radius: 10px;
    background: linear-gradient(145deg, #ffffff16, #ffffff05);
  }
  .portfolio-grid span {
    color: #d2c7c1;
    font: 9px 'Geist Mono', monospace;
  }
  .portfolio-grid strong {
    max-width: 160px;
    font-size: 14px;
    font-weight: 500;
  }
  .opinion-preview blockquote {
    max-width: 760px;
    margin-top: 18px;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(24px, 3.5vw, 38px);
    line-height: 1.2;
  }
  .firma-opinion {
    margin-top: 16px;
    color: var(--brand-muted);
    font-size: 11px;
  }
  .contacto-preview {
    display: grid;
    grid-template-columns: 1fr minmax(210px, 0.8fr);
    gap: 32px;
  }
  .contacto-preview h2 {
    font-size: clamp(28px, 4vw, 42px);
  }
  .contacto-email {
    margin-top: 18px;
    color: #d2c7c1;
    font-size: 12px;
  }
  .contacto-preview form {
    display: grid;
    gap: 11px;
  }
  .contacto-preview label {
    display: grid;
    gap: 5px;
    color: #d2c7c1;
    font-size: 10px;
  }
  .contacto-preview input,
  .contacto-preview textarea {
    width: 100%;
    padding: 9px;
    border: 1px solid #ffffff2a;
    border-radius: 7px;
    background: #ffffff0b;
    color: #fff;
    font: 12px 'DM Sans', sans-serif;
  }
  .contacto-preview .boton-preview {
    width: 100%;
    margin-top: 4px;
  }
  [data-contacto-estado] {
    min-height: 16px;
    color: #a9e3b2;
    font-size: 11px;
  }
  .sitio-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px clamp(16px, 4vw, 48px);
    color: var(--brand-muted);
    font-size: 10px;
  }
  .sitio-footer > a:first-child {
    color: var(--brand-text);
    font-size: 11px;
  }
  .sitio-footer > a:first-child span:first-child {
    width: 25px;
    height: 25px;
    font-size: 10px;
  }
  .sitio [hidden] {
    display: none !important;
  }
  @media (max-width: 980px) {
    .workspace {
      grid-template-columns: 280px minmax(0, 1fr);
    }
    .sitio-nav nav {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .intro {
      margin-top: 42px;
    }
    .workspace {
      grid-template-columns: 1fr;
    }
    .editor {
      position: static;
      max-height: none;
    }
  }
  @media (max-width: 520px) {
    .barra-demo .modo {
      display: none;
    }
    .preview {
      padding: 8px;
      border-radius: 12px;
    }
    .preview-label {
      display: none;
    }
    .hero-preview {
      grid-template-columns: 1fr;
    }
    .hero-imagen {
      max-height: 220px;
      aspect-ratio: 1.5;
      border-radius: 12px;
    }
    .servicios-preview > ul,
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
    .servicios-preview li {
      min-height: auto;
    }
    .servicios-preview li span {
      margin-top: 7px;
    }
    .portfolio-grid article {
      min-height: 100px;
    }
    .contacto-preview {
      grid-template-columns: 1fr;
    }
    .sitio-footer > span {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
