---
/**
 * Ticket del turno (paso 4): parte superior con servicio/profesional, separador punteado
 * con muescas semicirculares a los costados, y parte inferior con fecha, hora y montos.
 * Los valores los completa turnos.ts.
 */
---

<div class="ticket" data-ticket>
  <div class="parte">
    <p class="text-[13px] font-medium" style="color:var(--tinta-2)">Servicio</p>
    <p class="text-[20px] font-semibold tracking-tight" data-t-servicio></p>
    <p class="mt-3 text-[13px] font-medium" style="color:var(--tinta-2)">Profesional</p>
    <p class="text-[16px] font-medium" data-t-profesional></p>
  </div>
  <div class="corte" aria-hidden="true"></div>
  <div class="parte">
    <dl class="grid grid-cols-2 gap-y-3 text-[15px]">
      <div><dt style="color:var(--tinta-2)">Fecha</dt><dd class="font-semibold" data-t-fecha></dd></div>
      <div><dt style="color:var(--tinta-2)">Hora</dt><dd class="font-semibold tabular-nums" data-t-hora></dd></div>
      <div><dt style="color:var(--tinta-2)">Precio</dt><dd class="font-semibold tabular-nums" data-t-precio></dd></div>
      <div data-t-fila-sena><dt style="color:var(--tinta-2)">Seña</dt><dd class="font-semibold tabular-nums" data-t-sena></dd></div>
    </dl>
  </div>
</div>

<style>
  .ticket {
    position: relative;
    background: var(--superficie);
    border-radius: 24px;
    box-shadow: var(--sombra-card);
  }
  .parte {
    padding: 20px 24px;
  }
  .corte {
    position: relative;
    height: 0;
    margin-inline: 24px;
    border-top: 2px dashed var(--hairline);
  }
  .corte::before,
  .corte::after {
    content: '';
    position: absolute;
    top: -13px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--lienzo);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.05);
  }
  .corte::before {
    left: -36px;
  }
  .corte::after {
    right: -36px;
  }
</style>
