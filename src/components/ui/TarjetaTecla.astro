---
/** Tarjeta con borde y elevación discreta. */
interface Props {
  as?: 'div' | 'article' | 'li' | 'section';
  destacada?: boolean;
  grande?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = 'div', destacada = false, grande = false, class: clase, ...resto } = Astro.props;
---

<Tag class:list={['tecla', { destacada, grande }, clase]} {...resto}>
  <slot />
</Tag>

<style>
  .tecla {
    position: relative;
    padding: 30px;
    border: 1px solid var(--linea);
    border-radius: 16px;
    background: var(--vino-900);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    transition:
      transform 180ms var(--ease),
      border-color 180ms var(--ease),
      box-shadow 180ms var(--ease);
  }
  .tecla.grande {
    border-radius: 18px;
  }
  @media (hover: hover) {
    .tecla:hover {
      transform: translateY(-3px);
      border-color: #596658;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
    }
  }
  .destacada {
    border-color: #596658;
    background: var(--vino-850);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.2);
  }
  @media (hover: hover) {
    .destacada:hover {
      border-color: var(--verde);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.3);
    }
  }
</style>
