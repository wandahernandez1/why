---
/** Barra inferior mobile: píldora de vidrio flotante que aparece después del hero. */
import BotonPrimario from './BotonPrimario.astro';
import BotonSecundario from './BotonSecundario.astro';
import Icono from './Icono.astro';

interface Props {
  mensaje: string;
  despuesDe?: string;
}
const { mensaje, despuesDe = 'inicio' } = Astro.props;
---

<div class="barra-movil" data-barra-movil data-despues-de={despuesDe} aria-hidden="true" inert>
  <BotonSecundario href="#demos" class="flex-1">Demos</BotonSecundario>
  <BotonPrimario whatsapp={mensaje} ubicacion="barra_movil" class="flex-1">
    <Icono nombre="whatsapp-logo" tamano={18} />
    WhatsApp
  </BotonPrimario>
</div>

<style>
  .barra-movil {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    gap: 8px;
    padding: 8px;
    border-radius: 16px;
    background: rgba(11, 3, 6, 0.6);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    backdrop-filter: blur(24px) saturate(140%);
    box-shadow: inset 0 0 0 1px var(--linea);
    transform: translateY(calc(100% + 32px));
    transition: transform 300ms var(--ease);
  }
  .barra-movil.visible {
    transform: none;
  }
  @media (min-width: 768px) {
    .barra-movil {
      display: none;
    }
  }
</style>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra-movil]');
  const ref = barra && document.getElementById(barra.dataset.despuesDe || '');
  if (barra && ref && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      const mostrar = !e.isIntersecting && e.boundingClientRect.top < 0;
      barra.classList.toggle('visible', mostrar);
      barra.toggleAttribute('inert', !mostrar);
      barra.setAttribute('aria-hidden', String(!mostrar));
    }).observe(ref);
  }
</script>
