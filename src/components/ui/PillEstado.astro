---
/** Píldora de estado en Geist Mono con punto verde que late (2s). */
interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
---

<p class:list={['pill-estado', clase]}>
  <span class="punto" aria-hidden="true"></span>
  <slot />
</p>

<style>
  .pill-estado {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 12px;
    border-radius: var(--r-pill);
    background: rgba(255, 253, 250, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 253, 250, 0.24);
    font-family: var(--fuente-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fffdfa;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .punto {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verde);
  }
  .punto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--verde);
    animation: latir 2s var(--ease) infinite;
  }
  @keyframes latir {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
</style>
